<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="indoor_world">

    <!-- Physics and required system plugins for Gazebo Harmonic -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- Sunlight -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- OUTER WALLS — 10m × 10m enclosure, 2m tall, 0.15m thick -->
    <!-- Each wall is a static box model positioned at the boundary -->

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.3 0.15 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.3 0.15 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.3 0.15 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.3 0.15 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.0 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.3 0.15 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.3 0.15 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.0 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.3 0.15 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.3 0.15 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- INNER WALL — divides room in two with a 1.5m doorway gap in the middle -->
    <model name="inner_wall_left">
      <static>true</static>
      <pose>-2.875 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.25 0.15 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.25 0.15 2.0</size></box></geometry>
          <material><ambient>0.5 0.55 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="inner_wall_right">
      <static>true</static>
      <pose>2.875 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.25 0.15 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.25 0.15 2.0</size></box></geometry>
          <material><ambient>0.5 0.55 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- OBSTACLES — red, green, blue boxes and orange cylinders -->
    <model name="box_red">
      <static>true</static>
      <pose>-3.5 -3 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="box_green">
      <static>true</static>
      <pose>2.5 -3.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.3 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.3 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_orange">
      <static>true</static>
      <pose>-1.5 -2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="box_blue">
      <static>true</static>
      <pose>3 3 0.25 0 0 0.8</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.6 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.6 0.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>